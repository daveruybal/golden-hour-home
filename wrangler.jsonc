{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Landing page for goldenhourtools.com: static files only, no server code.
	"name": "golden-hour-home",
	"compatibility_date": "2025-09-01",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./public"
	},
	// Attaches the Worker to the bare domain and www. Cloudflare creates the DNS records.
	"routes": [
		{ "pattern": "goldenhourtools.com", "custom_domain": true },
		{ "pattern": "www.goldenhourtools.com", "custom_domain": true }
	]
}
